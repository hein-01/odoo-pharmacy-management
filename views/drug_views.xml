<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--   Inherit account move to add the hotel booking id-->
    <record id="view_drug_view_form" model="ir.ui.view">
        <field name="name">drug.view.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="expiry_date"/>
                <field name="cards_per_bu"/>
                <field name="tablets_per_card"/>
            </xpath>

            <xpath expr="//div[@name='list_price_uom']/field[@name='list_price']" position="after">
                <xpath expr="//div[@name='standard_price_uom']/span" position="move"/>
            </xpath>

             <xpath expr="//div[@name='standard_price_uom']/field[@name='standard_price']" position="after">
                <xpath expr="//span[@name='uom_span']" position="move"/>
            </xpath>

            <xpath expr="//field[@name='tablets_per_card']" position="after">
                <xpath expr="//label[@for='standard_price']" position="move"/>
                <xpath expr="//div[@name='standard_price_uom']" position="move"/>
                <field name="margin"/>
            </xpath>

        </field>
    </record>

    <record id="view_drug_view_list" model="ir.ui.view">
        <field name="name">drug.view.list.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="expiry_date"/>
                <field name="due_label"
                       decoration-danger = "due &lt;= 0"
                       decoration-warning = "due &lt;= 30"
                       decoration-info = "due &gt; 30"
                       invisible = "not expiry_date"
                       widget="badge"/>
                <field name="quantity_available"/>
            </xpath>
        </field>
    </record>
</odoo>
